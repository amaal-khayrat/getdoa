# Copy to tanstack/.env (or run dev-setup/init.ps1 which syncs local/tanstack.env → tanstack/.env)
# Generate BETTER_AUTH_SECRET: openssl rand -base64 24  (or any 32+ char random string)

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match local/.env.db (host port mapped to container 5432)
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5423/postgres

ADMIN_EMAILS=

# Optional — only needed for subscription testing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_TEST_MODE=true
